  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@huggingface/transformers": "^3.7.0",
    "@types/three": "^0.181.0",
    "dialkit": "^2.2.1",
    "sharp": "^0.34.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.7.0"
  }
}
