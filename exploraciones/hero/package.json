{
  "name": "antaris-exploracion-hero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Exploración aislada: hero de Antaris Polar (capas ilustradas con parallax por profundidad + base, pingüino y agua en Three.js). Reconstrucción artística, no geografía medida.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3420 --strictPort",
