# dependencias y builds (de cada exploración y del pipeline)
node_modules/
dist/
.vite/
*.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*

# env files
.env*

# local editor/agent settings (rutas y configuración propias de cada máquina)
.claude/settings.local.json
.claude/launch.json

# ─── Datos crudos regenerables (no se versionan) ───
# GeoTIFF REMA 2 m y vistas previas: ~100 MB. Se regeneran con
#   cd pipeline/rema && npm install && node fetch-potter-cove.mjs && node fetch-bases.mjs
# y se verifican con el sha256 que guarda cada data/rema/<base>_2m.json.
/data/rema/*.tif
/data/rema/*.png

# Malla única de depuración (?geo=completa): no se publica; se genera con
# exploraciones/terreno-estilizado/scripts/rehornear-brown.mjs --completa para validar la costa.
exploraciones/terreno-nitidez/public/terreno/*/malla-*-completa.bin.gz
